{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalDependencies": [".env*", "composer.json", "composer.lock", "phpcs.xml.dist"],
	"globalEnv": ["NODE_ENV", "WP_DEBUG", "WP_DEBUG_LOG"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["build/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"src/**",
				"*.config.js",
				"*.json",
				"webpack.config.js",
				"webpack.scripts.js"
			],
			"cache": true
		},
		"build:dev": {
			"dependsOn": ["^build:dev"],
			"outputs": ["build/**"],
			"cache": true
		},
		"build:prod": {
			"dependsOn": ["^build:prod"],
			"outputs": ["build/**"],
			"cache": true
		},
		"start": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		},
		"lint": {
			"inputs": [
				"src/**",
				"Functions/**",
				"**/*.{js,jsx,ts,tsx,scss,css,php}",
				"!build/**",
				"!vendor/**",
				"!node_modules/**"
			],
			"cache": true
		},
		"lint:js": {
			"inputs": [
				"src/**",
				"**/*.{js,jsx,ts,tsx}",
				"!build/**",
				"!vendor/**",
				"!node_modules/**"
			],
			"cache": true
		},
		"lint:css": {
			"inputs": ["src/**", "**/*.{scss,css}", "!build/**", "!vendor/**", "!node_modules/**"],
			"cache": true
		},
		"format": {
			"inputs": [
				"src/**",
				"Functions/**",
				"**/*.{js,jsx,ts,tsx,scss,css,php,twig}",
				"!build/**",
				"!vendor/**",
				"!node_modules/**"
			],
			"cache": true
		},
		"clean": {
			"cache": false
		}
	}
}
