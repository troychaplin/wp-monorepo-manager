{
	"name": "wp-monorepo-manager",
	"version": "0.1.0",
	"description": "A build tool for managing WordPress themes and plugins in a monorepo structure",
	"main": "index.js",
	"bin": {
		"wp-monorepo": "./bin/wp-monorepo.js",
		"wp-monorepo-manager": "./bin/wp-monorepo.js"
	},
	"packageManager": "npm@10.2.4",
	"files": [
		"bin",
		"config",
		"index.js",
		"turbo.json"
	],
	"scripts": {
		"setup-monorepo": "node scripts/setup-monorepo.js",
		"setup-theme": "node scripts/setup-theme.js",
		"setup-plugin": "node scripts/setup-plugin.js"
	},
	"keywords": [
		"wordpress",
		"monorepo",
		"build-tools",
		"eslint",
		"stylelint",
		"phpcs",
		"webpack",
		"turbo"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@wordpress/browserslist-config": "^6.26.0",
		"@wordpress/eslint-plugin": "22.12.0",
		"@wordpress/scripts": "30.19.0",
		"css-loader": "^7.1.2",
		"eslint-config-wordpress": "2.0.0",
		"postcss-import": "^16.1.1",
		"prettier": "3.6.2",
		"sass": "^1.89.2",
		"sass-loader": "^16.0.5",
		"stylelint": "16.21.1",
		"stylelint-scss": "^6.12.1",
		"turbo": "2.5.4"
	},
	"peerDependencies": {
		"webpack": ">=5.99.9"
	},
	"peerDependenciesMeta": {
		"webpack": {
			"optional": true
		}
	},
	"devDependencies": {
		"@commitlint/cli": "19.8.1",
		"@commitlint/config-conventional": "19.8.1",
		"@wordpress/blocks": "^14.15.0",
		"@wordpress/data": "^10.26.0",
		"@wordpress/dom-ready": "^4.26.0",
		"@wordpress/element": "^6.26.0",
		"@wordpress/i18n": "^5.26.0",
		"@wordpress/icons": "^10.26.0",
		"@wordpress/interactivity": "^6.26.0",
		"concurrently": "^9.2.0",
		"husky": "9.1.7",
		"mini-css-extract-plugin": "^2.9.2",
		"webpack-cli": "^6.0.1",
		"webpack-remove-empty-scripts": "^1.1.1"
	}
}
