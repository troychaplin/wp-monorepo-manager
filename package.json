{
	"name": "wp-monorepo-manager",
	"version": "0.1.0",
	"description": "A build tool for managing WordPress themes and plugins in a monorepo structure",
	"main": "index.js",
	"bin": {
		"wp-monorepo-manager": "./bin/wp-monorepo.js"
	},
	"packageManager": "npm@10.2.4",
	"files": [
		"bin",
		"config",
		"index.js",
		"turbo.json"
	],
	"scripts": {
		"build": "turbo run build",
		"build:dev": "turbo run build:dev",
		"build:prod": "turbo run build:prod",
		"start": "turbo run start",
		"lint:js": "turbo run lint:js",
		"lint:css": "turbo run lint:css",
		"lint:php": "turbo run lint:php",
		"format": "turbo run format",
		"format:js": "turbo run format:js",
		"format:css": "turbo run format:css",
		"format:php": "turbo run format:php",
		"clean": "turbo run clean",
		"test": "echo \"Error: no test specified\" && exit 1",
		"setup-test": "node scripts/setup-test.js"
	},
	"keywords": [
		"wordpress",
		"monorepo",
		"build-tools",
		"eslint",
		"stylelint",
		"phpcs",
		"webpack",
		"turbo"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"postcss-import": "^16.1.0",
		"prettier": "3.5.3"
	},
	"peerDependencies": {
		"@wordpress/scripts": ">=30.18.0",
		"eslint-config-wordpress": ">=2.0.0",
		"stylelint": ">=16.20.0",
		"stylelint-scss": ">=6.11.1",
		"turbo": ">=2.5.4",
		"webpack": ">=5.98.0"
	},
	"peerDependenciesMeta": {
		"@wordpress/scripts": {
			"optional": false
		},
		"eslint-config-wordpress": {
			"optional": true
		},
		"stylelint": {
			"optional": true
		},
		"stylelint-scss": {
			"optional": true
		},
		"turbo": {
			"optional": false
		},
		"webpack": {
			"optional": true
		}
	},
	"devDependencies": {
		"@commitlint/cli": "19.8.1",
		"@commitlint/config-conventional": "19.8.1",
		"@wordpress/blocks": "^14.10.0",
		"@wordpress/browserslist-config": "^6.25.0",
		"@wordpress/data": "^10.21.0",
		"@wordpress/dom-ready": "^4.21.0",
		"@wordpress/element": "^6.21.0",
		"@wordpress/i18n": "^5.21.0",
		"@wordpress/icons": "^10.21.0",
		"@wordpress/interactivity": "^6.21.0",
		"@wordpress/scripts": "^30.18.0",
		"concurrently": "^9.1.2",
		"css-loader": "^7.1.2",
		"husky": "9.1.7",
		"mini-css-extract-plugin": "^2.9.2",
		"sass-loader": "^16.0.5",
		"webpack-cli": "^6.0.1",
		"webpack-remove-empty-scripts": "^1.1.1"
	}
}
